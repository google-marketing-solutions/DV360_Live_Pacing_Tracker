{
  "name": "live-pacing-tracker",
  "version": "0.0.0",
  "description": "",
  "main": "build/src/index.js",
  "types": "build/src/index.d.ts",
  "files": [
    "build/src"
  ],
  "license": "Apache-2.0",
  "keywords": [],
  "scripts": {
    "test": "jest",
    "lint": "gts lint",
    "clean": "rimraf build dist",
    "bundle": "rollup --no-treeshake -c rollup.config.mjs",
    "build": "npm run clean && npm run bundle",
    "license": "license-check-and-add add -f license-config.json",
    "deploy:base": "npm run test && npm run build && ncp appsscript.json dist/appsscript.json && clasp push -f",
    "deploy": "ncp .clasp-dev.json .clasp.json && npm run deploy:base",
    "deploy:prod": "ncp .clasp-prod.json .clasp.json && npm run deploy:base",
    "compile": "tsc",
    "fix": "gts fix",
    "prepare": "npm run compile",
    "pretest": "npm run compile",
    "posttest": "npm run lint"
  },
  "devDependencies": {
    "@babel/preset-typescript": "^7.27.0",
    "@google/clasp": "^2.5.0",
    "@jest/globals": "^29.7.0",
    "@types/google-apps-script": "^1.0.91",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.7.5",
    "gts": "^6.0.2",
    "jest": "^29.7.0",
    "license-check-and-add": "^4.0.5",
    "ncp": "^2.0.0",
    "rimraf": "^6.0.1",
    "rollup": "^4.32.1",
    "rollup-plugin-cleanup": "^3.2.1",
    "rollup-plugin-license": "^3.7.1",
    "rollup-plugin-prettier": "^4.1.1",
    "rollup-plugin-typescript2": "^0.36.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.1.3"
  }
}
